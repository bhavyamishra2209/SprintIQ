# Storage backend: "memory" (default for zero-dependency development/testing) or "supabase"
STORAGE_BACKEND=memory

# Supabase URL (fill in later when STORAGE_BACKEND=supabase)
SUPABASE_URL=

# Supabase Service Role Key (fill in later when STORAGE_BACKEND=supabase; bypasses RLS for backend operations)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Anon Key (fill in later for direct client operations)
SUPABASE_ANON_KEY=

# Jira Mock Mode: true (default, uses offline test fixtures) or false (connects to real Jira Cloud REST API)
JIRA_USE_MOCK=true

# Jira Cloud Base URL, e.g. https://your-domain.atlassian.net (fill in later when JIRA_USE_MOCK=false)
JIRA_BASE_URL=

# Jira Cloud Email address (fill in later when JIRA_USE_MOCK=false)
JIRA_EMAIL=

# Jira Cloud API Token (fill in later when JIRA_USE_MOCK=false)
JIRA_API_TOKEN=

# Jira custom field ID for Story Points (defaults to customfield_10016)
JIRA_STORY_POINTS_FIELD=customfield_10016

# Jira custom field ID for Sprints (defaults to customfield_10020)
JIRA_SPRINT_FIELD=customfield_10020

# Hours multiplier per Story Point when original estimate is absent (defaults to 4)
JIRA_HOURS_PER_STORY_POINT=4.0

# Application environment: "dev", "test", or "prod"
APP_ENV=dev
